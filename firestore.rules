rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin: `admin` custom claim on a verified email
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('admin', false) == true &&
        request.auth.token.get('email_verified', false) == true;
    }

    // True when the signed-in user owns the case
    function ownsCase(caseId) {
      return isAuthenticated() && caseId is string &&
        get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - users can only read/write their own profile
    // The portal looks a client's profile up by its uid or email field, so those match too
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        (isAuthenticated() &&
         (resource.data.uid == request.auth.uid ||
          (resource.data.email == request.auth.token.email &&
           request.auth.token.get('email_verified', false) == true)));
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Cases collection - users can only access their own cases
    match /cases/{caseId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Documents collection - users can only access their own documents, admin can access all
    // Owner = userId (main site), clientId (portal), or the owner of the document's case
    match /documents/{docId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.clientId == request.auth.uid ||
         ownsCase(resource.data.caseId) ||
         isAdmin());
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.clientId == request.auth.uid ||
         isAdmin());
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.clientId == request.auth.uid ||
         ownsCase(resource.data.caseId) ||
         isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Messages collection - users can only access their own messages
    // Owner = userId / clientId on the message, or the owner of the message's case
    match /messages/{messageId} {
      allow read, update: if isAdmin() ||
        (isAuthenticated() &&
         (resource.data.userId == request.auth.uid ||
          resource.data.clientId == request.auth.uid ||
          ownsCase(resource.data.caseId)));
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.senderId == request.auth.uid &&
         ownsCase(request.resource.data.caseId));
      allow delete: if isAdmin();
    }

    // Payments collection - users can only see their own payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Signature Requests collection - the client it belongs to and the attorney.
    // The public /sign/{id} link reads and signs through Cloud Functions.
    match /signatureRequests/{requestId} {
      allow read, update: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Vaults collection - users can only access their own vault
    match /vaults/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ========== PORTAL COLLECTIONS ==========

    // Appointments collection - the client it belongs to and the attorney.
    // Anyone can book (guest bookings); guests look up and cancel through Cloud Functions.
    match /appointments/{appointmentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAdmin() ||
                       (isAuthenticated() && request.resource.data.clientId == request.auth.uid) ||
                       (request.resource.data.clientId == 'guest' &&
                        request.resource.data.isGuestBooking == true);
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid &&
         request.resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Booked times only (no client details), kept in sync by the syncBookedSlot function
    match /bookedSlots/{appointmentId} {
      allow read: if true;
      allow write: if false;
    }

    // Clients collection - the client's own record and the attorney
    match /clients/{clientId} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
         (clientId == request.auth.uid ||
          resource.data.clientId == request.auth.uid ||
          resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Matters, billings and tasks - the client they belong to and the attorney
    match /matters/{matterId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /billings/{billingId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Email Sequences collection - managed by Cloud Functions
    match /emailSequences/{sequenceId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
