rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin: `admin` custom claim on a verified email
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('admin', false) == true &&
        request.auth.token.get('email_verified', false) == true;
    }

    // True when the signed-in user owns the case
    function ownsCase(caseId) {
      return isAuthenticated() && caseId is string &&
        get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid;
    }

    // Fields only the attorney (admin) or server code (Admin SDK) may set: phase, status,
    // payment and paid fields, what was bought, and records the server keeps.
    function protectedCaseKeys() {
      return ['currentPhase', 'phase', 'status', 'closedAt',
              'payment', 'paymentStatus', 'paymentPlan', 'paymentDate', 'paymentIntentId', 'paymentMethod',
              'paid', 'paidAt', 'amountPaid', 'totalPaid', 'installmentsRemaining',
              'stripeSessionId', 'stripeCustomerId', 'stripeSubscriptionId',
              'serviceType', 'addOns'];
    }
    function protectedUserKeys() {
      return protectedCaseKeys().concat(['role', 'admin', 'isAdmin', 'esignConsent', 'welcomePending']);
    }
    // The update leaves every protected field exactly as it was
    function keepsProtected(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }
    // A client-created case starts unpaid, at phase 1, pending payment (intake)
    function isNewUnpaidCase() {
      let d = request.resource.data;
      return (!('status' in d) || d.status == 'pending_payment') &&
             (!('currentPhase' in d) || d.currentPhase == 1) &&
             !d.keys().hasAny(['phase', 'closedAt', 'paymentStatus', 'paymentDate', 'paymentIntentId', 'paid',
                               'paidAt', 'amountPaid', 'totalPaid', 'installmentsRemaining',
                               'stripeSessionId', 'stripeCustomerId', 'stripeSubscriptionId']) &&
             (!('payment' in d) ||
              (d.payment is map && d.payment.get('status', 'pending') == 'pending' &&
               d.payment.get('paidAt', null) == null &&
               !d.payment.keys().hasAny(['amountPaid', 'paid', 'stripeSessionId'])));
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - users can only read/write their own profile
    // The portal looks a client's profile up by its uid or email field, so those match too
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        (isAuthenticated() &&
         (resource.data.uid == request.auth.uid ||
          (resource.data.email == request.auth.token.email &&
           request.auth.token.get('email_verified', false) == true)));
      allow create: if isAdmin() ||
        (isOwner(userId) && !request.resource.data.keys().hasAny(protectedUserKeys()));
      allow update: if isAdmin() || (isOwner(userId) && keepsProtected(protectedUserKeys()));
      allow delete: if isAdmin();
    }

    // Cases collection - users can only access their own cases
    match /cases/{caseId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid && isNewUnpaidCase());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid &&
         keepsProtected(protectedCaseKeys()));
      allow delete: if isAdmin();
    }

    // Documents collection - users can only access their own documents, admin can access all
    // Owner = userId (main site), clientId (portal), or the owner of the document's case
    match /documents/{docId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.clientId == request.auth.uid ||
         ownsCase(resource.data.caseId) ||
         isAdmin());
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.clientId == request.auth.uid ||
         isAdmin());
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.clientId == request.auth.uid ||
         ownsCase(resource.data.caseId) ||
         isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Messages collection - users can only access their own messages
    // Owner = userId / clientId on the message, or the owner of the message's case
    match /messages/{messageId} {
      function ownsMessage() {
        return isAuthenticated() &&
          (resource.data.get('userId', null) == request.auth.uid ||
           resource.data.get('clientId', null) == request.auth.uid ||
           ownsCase(resource.data.get('caseId', null)));
      }
      allow read: if isAdmin() || ownsMessage();
      // Clients only mark messages as read; they never change what was written (W3-home)
      allow update: if isAdmin() ||
        (ownsMessage() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'unread', 'readByClientAt']));
      // A client writes as themselves, never as the office: on their case, or (no case yet) to their own thread
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.senderId == request.auth.uid &&
         request.resource.data.get('isAdmin', false) != true &&
         request.resource.data.get('senderRole', 'client') == 'client' &&
         (ownsCase(request.resource.data.get('caseId', null)) ||
          (request.resource.data.get('caseId', null) == null &&
           request.resource.data.get('clientId', null) == request.auth.uid)));
      allow delete: if isAdmin();
    }

    // Steps the client does outside the app (mail the notices, newspaper notice, file), with documents and
    // instructions (W3-home, decision 22). Written by the server/attorney; the client only marks done or not done.
    match /cases/{caseId}/clientSteps/{stepId} {
      allow read: if isAdmin() || ownsCase(caseId);
      allow update: if isAdmin() ||
        (ownsCase(caseId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt', 'doneBy']) &&
         request.resource.data.status in ['todo', 'done'] &&
         request.resource.data.doneBy == 'client');
      allow create, delete: if isAdmin();
    }

    // Intake answers saved as the client types (any device). W3-home item 53.
    match /intakeDrafts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.size() < 900000;
      allow delete: if isAdmin();
    }

    // Client home switches (for example whether client notices go beyond test inboxes): admin only
    match /config/clientHome {
      allow read, write: if isAdmin();
    }

    // Payments collection - users can only see their own payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();  // payment records come from the Stripe webhook (Admin SDK)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Signature Requests collection - the client it belongs to and the attorney.
    // The public /sign/{id} link reads and signs through Cloud Functions.
    // Signing audit trail: written only by Cloud Functions, readable by the attorney
    match /signatureRequests/{requestId}/events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Signing (status, signed, signature data) is recorded only by the signing Cloud Functions.
    match /signatureRequests/{requestId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow update: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Vaults collection - users can only access their own vault
    match /vaults/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ========== PORTAL COLLECTIONS ==========

    // Appointments collection - the client it belongs to and the attorney.
    // Guests book through the createGuestBooking Cloud Function (checked and rate limited);
    // they cancel by signing in or with the signed link in the confirmation email.
    match /appointments/{appointmentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAdmin() ||
                       (isAuthenticated() && request.resource.data.clientId == request.auth.uid);
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid &&
         request.resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Booked times only (no client details), kept in sync by the syncBookedSlot function
    match /bookedSlots/{appointmentId} {
      allow read: if true;
      allow write: if false;
    }

    // Clients collection - the client's own record and the attorney
    match /clients/{clientId} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
         (clientId == request.auth.uid ||
          resource.data.clientId == request.auth.uid ||
          resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Matters, billings and tasks - the client they belong to and the attorney
    match /matters/{matterId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /billings/{billingId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Shared business settings (Rozsa's answers). No secrets: anyone may read; only admin writes.
    match /config/business {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ================= W3-cockpit section (attorney cockpit) =================
    // Owner: W3-cockpit. Shapes: notes/shared-data-model.md. All writes go through
    // admin-only Cloud Functions (Admin SDK), which also write the audit log.
    // Private case notes: the attorney only. Clients can never read them.
    match /cases/{caseId}/privateNotes/{noteId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Case task list and unsent document drafts: the attorney only
    match /cases/{caseId}/tasks/{taskId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cases/{caseId}/draftDocuments/{draftId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Version history of a document: the attorney and the document's owner may read
    match /documents/{docId}/versions/{versionId} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
         (get(/databases/$(database)/documents/documents/$(docId)).data.get('clientId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/documents/$(docId)).data.get('userId', '') == request.auth.uid));
      allow write: if false;
    }
    // Audit log and sent-email log: the attorney reads, only Cloud Functions write
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /emailLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Invoices and refunds (written by W2-payments functions): the attorney, and the client they belong to
    match /invoices/{invoiceId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('clientId', '') == request.auth.uid));
      allow write: if false;
    }
    match /refunds/{refundId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('clientId', '') == request.auth.uid));
      allow write: if false;
    }
    // Cockpit settings (reminders on/off): the attorney only
    match /config/cockpit {
      allow read: if isAdmin();
      allow write: if false;
    }
    // ================= end W3-cockpit section =================

    // ================= W3-forms section (court forms) =================
    // Owner: W3-forms. Shapes: notes/shared-data-model.md (W3-forms section).
    // Rozsa's answers to the generator's "needs your answer" questions, and the saved
    // versions of each generated form. The attorney only; clients can never read them.
    match /cases/{caseId}/formAnswers/{docId} {
      allow read, write: if isAdmin();
    }
    match /cases/{caseId}/formDrafts/{formKey} {
      allow read, write: if isAdmin();
    }
    // ================= end W3-forms section =================

    // Server-only data: rate-limit counters and the key for signed appointment links.
    // No client access at all (Cloud Functions use the Admin SDK).
    match /rateLimits/{id} {
      allow read, write: if false;
    }
    match /serverSecrets/{id} {
      allow read, write: if false;
    }

    // ========== W3-BEYOND (items 63 to 73) ==========
    // Feature switches for the W3-beyond tools: public read (no secrets), admin write
    match /config/beyondFeatures {
      allow read: if true;
      allow write: if isAdmin();
    }

    function ownsCaseOrAdmin(caseId) {
      return isAdmin() || ownsCase(caseId);
    }

    // 65: estate ledger (money in and out). The client and the attorney; never family viewers.
    function validLedgerEntry(d) {
      return d.keys().hasOnly(['date', 'direction', 'amountCents', 'category', 'description', 'source',
                               'importId', 'createdBy', 'createdAt', 'updatedAt']) &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.direction in ['in', 'out'] &&
        d.amountCents is int && d.amountCents > 0 && d.amountCents < 100000000000 &&
        d.category is string && d.category.size() <= 40 &&
        d.description is string && d.description.size() <= 200 &&
        (!('source' in d) || d.source in ['manual', 'csv']);
    }
    match /cases/{caseId}/ledger/{entryId} {
      allow read, delete: if ownsCaseOrAdmin(caseId);
      allow create: if ownsCaseOrAdmin(caseId) && validLedgerEntry(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if ownsCaseOrAdmin(caseId) && validLedgerEntry(request.resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy;
    }

    // 67: unclaimed property and life insurance searches (found / not found)
    match /cases/{caseId}/assetSearches/{searchKey} {
      allow read: if ownsCaseOrAdmin(caseId);
      allow write: if ownsCaseOrAdmin(caseId) &&
        searchKey in ['caUnclaimed', 'naicLife', 'missingMoney'] &&
        request.resource.data.keys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy']) &&
        request.resource.data.status in ['notStarted', 'searched', 'found', 'notFound'] &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 1000 &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 63: the client's reminder choices
    match /cases/{caseId}/settings/reminders {
      allow read: if ownsCaseOrAdmin(caseId);
      allow write: if ownsCaseOrAdmin(caseId) &&
        request.resource.data.keys().hasOnly(['email', 'sms', 'smsPhone', 'smsConsentAt', 'smsConsentText', 'updatedAt', 'updatedBy']) &&
        request.resource.data.email is bool && request.resource.data.sms is bool &&
        request.resource.data.smsPhone is string && request.resource.data.smsPhone.matches('^([0-9]{10})?$') &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    // 64: account-closing letters, written only by the letter function
    match /cases/{caseId}/institutionLetters/{letterId} {
      allow read: if ownsCaseOrAdmin(caseId);
      allow write: if false;
    }

    // 66: family access. Invites are managed by the attorney through functions.
    // Each family member reads only their own view, which a function builds from what the attorney chose.
    match /familyAccess/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /familyViews/{viewId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.heirUid == request.auth.uid);
      allow write: if false;
    }

    // Server-only bookkeeping (rate limits for the helper, reminder send log)
    match /beyondRateLimits/{id} {
      allow read, write: if false;
    }
    match /beyondReminderLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email Sequences collection - managed by Cloud Functions
    match /emailSequences/{sequenceId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
