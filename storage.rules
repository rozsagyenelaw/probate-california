rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = `admin` custom claim on a verified email
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('admin', false) == true &&
        request.auth.token.get('email_verified', false) == true;
    }

    // True when the signed-in user owns the case in Firestore
    // (needs roles/firebaserules.firestoreServiceAgent on the Storage service agent)
    function ownsCase(caseId) {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/cases/$(caseId)).data.userId == request.auth.uid;
    }

    // Intake documents - users can only access their own uploads
    match /intake/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Case documents - the client who owns the case and the attorney
    match /cases/{caseId}/documents/{allPaths=**} {
      allow read, write: if isAdmin() || ownsCase(caseId);
    }

    // Documents collection - for financial docs upload (asset discovery)
    match /documents/{caseId}/{allPaths=**} {
      allow read: if isAdmin() || ownsCase(caseId);
      allow create, update: if isAdmin() || ownsCase(caseId);
      allow delete: if isAdmin();
    }

    // Signature request documents - admin can upload, public can read for signing
    match /signature-requests/{allPaths=**} {
      allow read: if true;  // Public access for signing page
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Signed documents - the client the request belongs to and the attorney.
    // The signing Cloud Function writes with the Admin SDK (bypasses rules) and hands the
    // signer a tokenized download link through the signing page.
    match /signed-documents/{requestId}/{allPaths=**} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
         firestore.get(/databases/(default)/documents/signatureRequests/$(requestId)).data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Vault documents - users can only access their own vault
    match /vaults/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
