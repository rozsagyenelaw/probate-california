rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Client uploads: one limit everywhere, 20 MB per file (every client screen says "up to 20 MB")
    function underClientLimit() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = `admin` custom claim on a verified email
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('admin', false) == true &&
        request.auth.token.get('email_verified', false) == true;
    }

    // True when the signed-in user owns the case in Firestore
    // (needs roles/firebaserules.firestoreServiceAgent on the Storage service agent)
    function ownsCase(caseId) {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/cases/$(caseId)).data.userId == request.auth.uid;
    }

    // Intake documents - users can only access their own uploads
    match /intake/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == userId && underClientLimit();
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Case documents - the client who owns the case and the attorney
    match /cases/{caseId}/documents/{allPaths=**} {
      allow read, delete: if isAdmin() || ownsCase(caseId);
      allow create, update: if isAdmin() || (ownsCase(caseId) && underClientLimit());
    }

    // Documents collection - for financial docs upload (asset discovery)
    match /documents/{caseId}/{allPaths=**} {
      allow read: if isAdmin() || ownsCase(caseId);
      allow create, update: if isAdmin() || (ownsCase(caseId) && underClientLimit());
      allow delete: if isAdmin();
    }

    // Documents sent for signature - attorney only through the SDK (no public list or read).
    // The signer reaches the file only through getSigningSession, which checks the signed-in
    // recipient (or admin) and returns the private tokenized link stored on the request.
    match /signature-requests/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.resource.contentType == 'application/pdf'
                    && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Signed documents - the client the request belongs to and the attorney.
    // The signing Cloud Function writes with the Admin SDK (bypasses rules) and hands the
    // signer a tokenized download link through the signing page.
    match /signed-documents/{requestId}/{allPaths=**} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
         firestore.get(/databases/(default)/documents/signatureRequests/$(requestId)).data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ================= W3-cockpit section (attorney cockpit) =================
    // Owner: W3-cockpit. The attorney uploads here first; nothing here is visible to clients.
    // Sending copies the file (Cloud Function) to cases/{caseId}/documents/attorney/..., which the case owner can read.
    match /cockpit-uploads/{caseId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    // Main-site "Upload Prepared Document" path (it was denied by default before).
    // The attorney writes; the client who owns the case may read.
    match /cases/{caseId}/prepared-forms/{allPaths=**} {
      allow read: if isAdmin() || ownsCase(caseId);
      allow write: if isAdmin();
    }
    // ================= end W3-cockpit section =================

    // Client uploads before a case exists (W3-home item 54). Clients add files; they never
    // overwrite or delete them. With a case, uploads go to cases/{caseId}/documents/client/.
    match /client-uploads/{userId}/{fileName} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId && resource == null &&
        underClientLimit() &&
        (request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/msword') ||
         request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document'));
      allow update, delete: if isAdmin();
    }

    // Vault documents - users can only access their own vault
    match /vaults/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && underClientLimit());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
